      "content": "const MECHANIC_COMBO_BASE_BOXES = [\n    ['bear', 'bear'],\n    ['bear'],\n    ['duck', 'duck'],\n    ['duck']\n];\nconst MECHANIC_COMBO_MOVE = (from, slot, to) => ({ type: 'move', from, slot, to });\nconst MECHANIC_COMBO_WAIT = seconds => ({ type: 'wait', seconds });\n\nconst MECHANIC_COMBO_CATEGORY_ID = 'stuffed_animals';\nconst MECHANIC_COMBO_ITEM_TYPES = { bear: 'bear', duck: 'duck' };\n\nconst COMBO_COLUMNS_3 = [[0, 2], [1], [3]];\n\nexport const COMBO_SCENARIOS = [\n    {\n        id: 'combo-key', label: 'Chìa khóa phụ thuộc', tier: 'Normal / Hard',\n        description: 'Đóng gói hộp chìa khóa để mở đúng hộp khóa có tên.'\n    },\n    {\n        id: 'combo-sticky-oneway', label: 'Cặp dính và hộp một chiều', tier: 'Hard',\n        description: 'Chuyển nguyên cặp hai vật vào hai ô trống; hộp một chiều chỉ nhận vật.'\n    },\n    {\n        id: 'combo-hidden-urgent', label: 'Hộp ẩn khẩn cấp', tier: 'Hard',\n        description: 'Đồng hồ khẩn cấp chạy khi hộp tiếp cận được, kể cả khi vật bên trong còn bị che.'\n    },\n    {\n        id: 'combo-connector-queue', label: 'Liên kết và hàng chờ hẹp', tier: 'Super Hard',\n        description: 'Hai hộp liên kết phải vào hàng chờ nguyên cặp với sức chứa giới hạn.'\n    },\n    {\n        id: 'combo-frozen-colors', label: 'Băng giá đổi màu vật', tier: 'Super Hard',\n        description: 'Hai vật được theo dõi đổi loại đồng thời sau bốn giây, không làm thay đổi tổng số mỗi loại.'\n    },\n    {\n        id: 'combo-stuck-priority', label: 'Hộp kẹt và đơn ưu tiên', tier: 'Hard',\n        description: 'Giải phóng hộp kẹt để mở khay ưu tiên và chặn các đơn khác cho tới khi hoàn tất.'\n    }\n];\n\n/** Every call returns a completely fresh authored demo; campaign data is never consulted. */\nexport function createMechanicComboLevel(levelId) {\n    const scenario = COMBO_SCENARIOS.find(candidate => candidate.id === levelId);\n    if (!scenario) throw new Error(`Unknown mechanic combo scenario: ${levelId}`);\n    const boxes = MECHANIC_COMBO_BASE_BOXES.map(items => ({ items: items.slice() }));\n    if (levelId === 'combo-stuck-priority') boxes.push({ items: [] });\n    let columns = boxes.map((_, id) => [id]);\n    for (const id of ['combo-key', 'combo-hidden-urgent', 'combo-sticky-oneway', 'combo-connector-queue', 'combo-frozen-colors']) {\n        if (levelId === id) columns = COMBO_COLUMNS_3.map(column => column.slice());\n    }\n    if (levelId === 'combo-stuck-priority') columns = [[4, 2], [0, 1], [3]];\n    let blockers = [], mechanicCombo, referenceActions;\n    const ordinaryTrace = () => [MECHANIC_COMBO_MOVE(1, 0, 0), MECHANIC_COMBO_MOVE(3, 0, 2)];\n    if (levelId === 'combo-key') {\n        blockers = [{ id: 'combo-key-lock', type: 'locked', boxId: 2, dependsOnBoxId: 0 }];\n        mechanicCombo = { type: levelId, label: scenario.label, keyBoxId: 0, lockedBoxId: 2 };\n        referenceActions = ordinaryTrace();\n    } else if (levelId === 'combo-sticky-oneway') {\n        mechanicCombo = { type: levelId, label: scenario.label,\n            sticky: { boxId: 0, slots: [0, 1] }, oneWayBoxId: 1 };\n        referenceActions = [MECHANIC_COMBO_MOVE(0, 0, 1), MECHANIC_COMBO_MOVE(3, 0, 2)];\n    } else if (levelId === 'combo-hidden-urgent') {\n        blockers = [{ id: 'combo-hidden-face', type: 'hidden-box', boxId: 2 }];\n        mechanicCombo = { type: levelId, label: scenario.label, urgentBoxId: 2, duration: 30 };\n        referenceActions = ordinaryTrace();\n    } else if (levelId === 'combo-connector-queue') {\n        blockers = [{ id: 'combo-linked-pair', type: 'connector', boxIds: [0, 2], groupId: 'COMBO-A' }];\n        mechanicCombo = { type: levelId, label: scenario.label, boxIds: [0, 2], queueCapacity: 2 };\n        referenceActions = ordinaryTrace();\n    } else if (levelId === 'combo-frozen-colors') {\n        blockers = [{ id: 'combo-color-freeze', type: 'frozen', boxId: 1, slot: 0, duration: 3 }];\n        mechanicCombo = { type: levelId, label: scenario.label, swapAt: 4, tooltip: 'đổi loại sau4s',\n            first: { boxId: 1, slot: 0 }, second: { boxId: 3, slot: 0 } };\n        referenceActions = [MECHANIC_COMBO_WAIT(4), MECHANIC_COMBO_MOVE(3, 0, 0), MECHANIC_COMBO_MOVE(1, 0, 2)];\n    } else {\n        blockers = [{ id: 'combo-priority-stuck', type: 'stuck', boxId: 4, shipCount: 1 }];\n        mechanicCombo = { type: levelId, label: scenario.label, stuckBoxId: 4,\n            priorityTrayId: 'duck-order', priorityItemId: 'duck' };\n        referenceActions = ordinaryTrace();\n    }\n    return {\n        id: levelId,\n        label: scenario.label,\n        tier: scenario.tier,\n        description: scenario.description,\n        boxes,\n        trays: [\n            { id: 'bear-order', categoryId: MECHANIC_COMBO_CATEGORY_ID, targetItemId: MECHANIC_COMBO_ITEM_TYPES.bear, matchMode: 'exact' },\n            { id: 'duck-order', categoryId: MECHANIC_COMBO_CATEGORY_ID, targetItemId: MECHANIC_COMBO_ITEM_TYPES.duck, matchMode: 'exact' }\n        ],\n        maxActiveTrays: 2,\n        layout: { columns: columns.map(column => column.slice()), visibleRows: 4 },\n        rules: { timeToPlay: 120 },\n        blockers: blockers.map(record => ({ ...record, ...(record.boxIds ? { boxIds: record.boxIds.slice() } : {}) })),\n        mechanicCombo,\n        referenceActions: referenceActions.map(action => ({ ...action })),\n        referenceSolution: referenceActions.filter(action => action.type === 'move')\n            .map(action => ({ from: action.from, index: action.slot, to: action.to })),\n        solvable: false\n    };\n}\n\nfunction drainMechanicComboReplay(engine) {\n    let progressed = true;\n    for (let pass = 0; pass < 64 && progressed && engine.gameState === 'PLAYING'; pass++) {\n        progressed = false;\n        for (const box of [...engine.boxes]) {\n            if (box.isWrapped && engine.canQueueBlockerBox(box.id) && engine.moveBoxToQueue(box)) progressed = true;\n        }\n        for (let delivery = 0; delivery < 64 && engine.gameState === 'PLAYING'; delivery++) {\n            if (!engine.tryAutoFillTray()) break;\n            progressed = true;\n        }\n    }\n}\n\n/** Real GameEngine replay; success is exclusively its terminal WON state. */\nexport function replayMechanicComboLevel(GameEngineClass, level) {\n    const engine = new GameEngineClass();\n    engine.startLevel(level);\n    engine.startClock();\n    let failure = '';\n    for (const action of level.referenceActions || []) {\n        if (engine.gameState !== 'PLAYING') break;\n        if (action.type === 'wait') engine.advanceClock(action.seconds);\n        else if (action.type === 'move') {\n            if (!engine.moveItem(action.from, action.slot, action.to, action.targetSlot ?? null)) {\n                failure = `Reference move ${action.from}:${action.slot} -> ${action.to} was rejected.`;\n                break;\n            }\n        } else {\n            failure = `Unknown reference action ${action.type}.`;\n            break;\n        }\n        drainMechanicComboReplay(engine);\n    }\n    if (!failure && engine.gameState === 'PLAYING') {\n        drainMechanicComboReplay(engine);\n        engine.checkConditions();\n    }\n    return {\n        solved: engine.gameState === 'WON', state: engine.gameState,\n        failure: failure || engine.loseReason, moveCount: engine.moveCount, engine\n    };\n}\n"
    }
