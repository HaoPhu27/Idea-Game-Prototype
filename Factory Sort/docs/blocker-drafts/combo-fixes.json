      "to": "    engine.addExtraTray = function() {\n        if (!active()) return original.addExtraTray.call(engine);\n        if (state().type !== 'combo-connector-queue') {\n            const result = original.addExtraTray.call(engine);\n            refresh();\n            return result;\n        }\n        const oldCapacity = engine.maxQueueSize;\n        const savedOnQueueUpdated = engine.onQueueUpdated;\n        engine.onQueueUpdated = function(...cbArgs) {\n            engine.maxQueueSize = oldCapacity + 1;\n            if (savedOnQueueUpdated) savedOnQueueUpdated.apply(this, cbArgs);\n        };\n        let result;\n        try {\n            result = original.addExtraTray.call(engine);\n        } finally {\n            engine.onQueueUpdated = savedOnQueueUpdated;\n        }\n        if (result) {\n            engine.maxQueueSize = oldCapacity + 1;\n        } else {\n            engine.maxQueueSize = oldCapacity;\n        }\n        refresh();\n        if (result && savedOnQueueUpdated) savedOnQueueUpdated.call(engine, engine.queue);\n        notify(true);\n        return result;\n    };\n    function activeComboBlocksBoosters() {\n        const current = state();\n        if (!current) return false;\n        if (current.type === 'combo-sticky-oneway' && current.pair?.active) return true;\n        if (current.type === 'combo-frozen-colors' && current.swap && current.swap.status === 'pending') return true;\n        if (current.type === 'combo-hidden-urgent' && current.urgent && current.urgent.activated && !current.urgent.completed) return true;\n        if (current.type === 'combo-stuck-priority' && current.priority && !current.priority.fulfilled) return true;\n        if (current.type === 'combo-key' && !current.keyUsed) return true;\n        return false;\n    }\n    engine.shuffleItems = function(...args) {\n        if (!active()) return original.shuffleItems.apply(engine, args);\n        if (activeComboBlocksBoosters()) return engine._boosterFail('Không thể xáo bài khi cơ chế kết hợp đang hoạt động.');\n        const result = original.shuffleItems.apply(engine, args);\n        refresh();\n        return result;\n    };\n    engine.removeTray = function(...args) {\n        if (!active()) return original.removeTray.apply(engine, args);\n        if (activeComboBlocksBoosters()) return engine._boosterFail('Không thể xóa khay khi cơ chế kết hợp đang hoạt động.');\n        const result = original.removeTray.apply(engine, args);\n        refresh();\n        return result;\n    };"
